{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "expo": "^54.0.37",
    "expo-asset": "~12.0.13",
    "expo-haptics": "~15.0.8",
    "expo-speech": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "jszip": "^3.10.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "^26.4.1",
    "@types/react": "~19.1.10",
    "@v4nn4/ablaut": "^0.8.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.18",
    "typescript": "~5.9.2",
    "wait-on": "^9.1.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "cross-env TZ=UTC jest --watchAll",
    "electron:build": "tsc -p electron/tsconfig.json",
    "electron:start": "electron electron-dist/electron/main.js",
    "desktop": "npm run electron:build && concurrently -k -s first \"expo start --web\" \"wait-on http://localhost:8081 && npm run electron:start\"",
    "desktop:export": "expo export --platform web",
    "desktop:package": "npm run electron:build && npm run desktop:export && electron-builder --win"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "build": {
    "appId": "com.lexis.desktop",
    "productName": "Lexis",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron-dist/**/*"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "web-build"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "extraMetadata": {
      "main": "electron-dist/electron/main.js"
    }
  },
  "private": true
}
