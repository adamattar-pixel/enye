# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files — `.env` ajouté explicitement (21/08/2026, feature
# Livres) : contient la clé API DeepL personnelle de l'utilisateur, ne
# doit jamais être commit. Voir .env.example pour le nom de variable
# attendu, sans valeur réelle.
.env
.env*.local

# typescript
*.tsbuildinfo

# Electron — sortie compilée de `electron/*.ts` (voir `npm run electron:build`
# / docs/DECISIONS.md Decision 016), régénérée à chaque build, jamais commit.
/electron-dist/
# Electron — paquet Windows produit par `npm run desktop:package`
# (electron-builder), potentiellement volumineux, jamais commit.
# (`dist/`, la sortie de l'export web statique, est déjà ignorée plus
# haut par la règle Expo générique.)
/release/

# generated native folders
/ios
/android

# sources tierces téléchargées pour la génération de vocabulaire (~60 Mo,
# voir scripts/generate-vocabulary/README.md pour les retélécharger)
/scripts/generate-vocabulary/data/
